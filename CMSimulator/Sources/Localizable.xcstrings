        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina MVP y lanzamiento para poner el producto frente a la gente. Hasta entonces no hay clientes ni ingresos — solo quema."
          }
        }
      }
    },
    "Finish the first product line to go on sale. Stock ordered before then still has to be paid for, shipped and stored — it just cannot sell.": {
      "comment": "Trading panel: pre-launch explanation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the first product line to go on sale. Stock ordered before then still has to be paid for, shipped and stored — it just cannot sell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la primera línea de producto para salir a la venta. La mercancía pedida antes igual se paga, se embarca y se almacena — solo que no se puede vender."
          }
        }
      }
    },
