    "The previous session ended without reaching the background and without a crash signal. This usually means the system terminated the app for using too much memory, or it stopped responding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous session ended without reaching the background and without a crash signal. This usually means the system terminated the app for using too much memory, or it stopped responding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión anterior terminó sin pasar a segundo plano y sin señal de cierre inesperado. Normalmente significa que el sistema cerró la app por usar demasiada memoria, o que dejó de responder."
          }
        }
      },
      "comment": "Diagnostic detail"
    },
